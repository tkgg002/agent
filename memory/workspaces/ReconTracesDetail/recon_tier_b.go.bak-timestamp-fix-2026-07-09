func (rc *ReconCore) RunSegmentB(ctx context.Context, ref MasterBindingRef, deep bool) *recon.ReconciliationReport {
	if deep {
		return rc.RunDeepCheckB(ctx, ref)
	}
	return rc.RunHashWindowCheckB(ctx, ref)
}

func (rc *ReconCore) measureAndResolveWatermarksB(ctx context.Context, ref MasterBindingRef) (time.Time, time.Time, string, int64, error) {
	shadowRel, masterRel := ref.ShadowRel(), ref.MasterRel()

	// Resolve cột timestamp nghiệp vụ từ registry
	tsCol := "_source_ts"
	if entry, err := rc.registryRepo.GetByTargetTable(ctx, ref.MasterTable); err == nil && entry != nil {
		_, dstTS, errTS := rc.resolveSourceAndDestTSFields(ctx, *entry)
		if errTS == nil && dstTS != "" {
			tsCol = dstTS
		}
	}

	shMax, shErr := rc.destAgent.MaxWindowTs(ctx, shadowRel, tsCol)
	msMax, _ := rc.masterAgent.MaxWindowTs(ctx, masterRel, tsCol)
	transmuteLagMs := lagBetween(shMax, msMax)
	rc.upsertReconLag(ctx, ref.MasterTable, "transmute_lag_ms", transmuteLagMs)

	// Watermark: chuẩn theo shadow (upstream của B). upper kẹp now-adaptiveFreeze.
	upper := time.Now().Add(-rc.adaptiveFreeze(transmuteLagMs))
	if shErr == nil && !shMax.IsZero() && shMax.Before(upper) {
		upper = shMax.Add(time.Millisecond)
	}
	lower := upper.Add(-rc.cfg.WindowLookback)

	// Override with custom time range if present in context
	if customStart, customEnd, ok := GetReconTimeRange(ctx); ok {
		lower = customStart
		upper = customEnd
		observability.Ctx(ctx, rc.logger).Info("recon segment B using custom time range from context",
			zap.Time("start", lower), zap.Time("end", upper))
	}

	return lower, upper, tsCol, transmuteLagMs, shErr
}

func (rc *ReconCore) runCountCheckB(ctx context.Context, ref MasterBindingRef) (shadowFull, shadowActive, masterFull, masterActive int64, errSF, errMF error) {
	shadowRel, masterRel := ref.ShadowRel(), ref.MasterRel()
	shadowFull, errSF = rc.destAgent.CountRows(ctx, shadowRel, segBPKColumn)
	masterFull, errMF = rc.masterAgent.CountRows(ctx, masterRel, segBPKColumn)

	shadowActive = shadowFull
	if errSF == nil {
		if del, err := rc.destAgent.CountDeletedRows(ctx, shadowRel); err == nil {
			if a := shadowFull - del; a >= 0 {
				shadowActive = a
			}
		}
	}

	masterActive = masterFull
	if errMF == nil {
		if del, err := rc.masterAgent.CountDeletedRows(ctx, masterRel); err == nil {
			if a := masterFull - del; a >= 0 {
				masterActive = a
			}
		}
	}

	return shadowFull, shadowActive, masterFull, masterActive, errSF, errMF
}


func (rc *ReconCore) RunHashWindowCheckB(ctx context.Context, ref MasterBindingRef) *recon.ReconciliationReport {
	ctx, span := observability.ChildSpan(ctx, "cdc.recon.run_hash_window_check_b", attribute.String("table", ref.runName()))
	var finalErr error
	defer func() { observability.EndSpan(span, &finalErr) }()

	masterFQN := ref.MasterTable
	if ref.MasterSchema != "" {
		masterFQN = ref.MasterSchema + "." + ref.MasterTable
	}
	if rc.masterAgent == nil {
		observability.Ctx(ctx, rc.logger).Error("recon segment B: masterAgent not wired — skip",
			zap.String("table", ref.runName()))
		return nil
	}
	acquired, unlock := rc.withTableLock(ctx, "reconB_"+ref.runName())
	defer unlock()
	if !acquired {
		observability.Ctx(ctx, rc.logger).Info("recon segment B: lock busy, skip", zap.String("table", ref.runName()))
		return nil
	}
	handle, err := rc.beginRun(ctx, ref.runName(), tierSegmentB)
	if err != nil {
		observability.Ctx(ctx, rc.logger).Error("recon segment B: beginRun failed", zap.String("table", ref.runName()), zap.Error(err))
		return nil
	}
	finishStatus := "success"
	defer func() {
		if finishStatus == "failed" {
			finalErr = fmt.Errorf("hash window check segment B failed")
		}
	}()

	shadowRel, masterRel := ref.ShadowRel(), ref.MasterRel()
	lower, upper, tsCol, transmuteLagMs, _ := rc.measureAndResolveWatermarksB(ctx, ref)

	ctxCount, spanCount := observability.ChildSpan(ctx, "cdc.recon.run_count_check_b")
	shadowFull, shadowActive, masterFull, masterActive, errSF, errMF := rc.runCountCheckB(ctxCount, ref)
	spanCount.End()

	// Emit metrics
	if errSF == nil {
		metrics.ShadowTableRowCount.WithLabelValues(shadowRel).Set(float64(shadowFull))
		metrics.ShadowActiveRowCount.WithLabelValues(shadowRel).Set(float64(shadowActive))
	}
	if errMF == nil {
		metrics.MasterTableRowCount.WithLabelValues(masterFQN).Set(float64(masterFull))
		metrics.MasterActiveRowCount.WithLabelValues(masterFQN).Set(float64(masterActive))
	}

	if errSF == nil && errMF == nil && shadowActive == masterActive && transmuteLagMs == 0 {
		duration := int(time.Since(handle.started).Milliseconds())
		report := &recon.ReconciliationReport{
			TargetTable: masterFQN, SourceDB: "",
			SourceCount: &shadowActive, DestCount: masterActive, Diff: 0,
			TotalSourceCount: &shadowFull, TotalDestCount: &masterFull,
			CheckType: "count_total", Status: "ok",
			Segment: segmentShadowMaster, DurationMs: &duration, CheckedAt: time.Now().UTC(),
		}
		rc.stampB(report, ref)
		rc.finishRun(ctx, handle, "success", "")
		metrics.ReconDrift.WithLabelValues(masterFQN, "4").Set(0)
		return report
	}

	var (
		totalShadow, totalMaster int64
		missingFromMaster        []string
		orphanInMaster           []string
		staleIDs                 []string
		windowErrs               int
	)

	ctxBuckets, spanBuckets := observability.ChildSpan(ctx, "cdc.recon.bucket_counts_b")
	shBuckets, errS := rc.destAgent.BucketCounts(ctxBuckets, shadowRel, segBPKColumn, tsCol, lower, upper)
	msBuckets, errM := rc.masterAgent.BucketCounts(ctxBuckets, masterRel, segBPKColumn, tsCol, lower, upper)
	spanBuckets.End()

	if errS != nil || errM != nil {
		observability.Ctx(ctx, rc.logger).Warn("recon segment B: bucket scan error",
			zap.String("table", ref.runName()), zap.Error(errS), zap.NamedError("master_err", errM))
		windowErrs++
	}
	bucketKeys := make(map[int64]struct{}, len(shBuckets)+len(msBuckets))
	for k := range shBuckets {
		bucketKeys[k] = struct{}{}
	}
	for k := range msBuckets {
		bucketKeys[k] = struct{}{}
	}
	driftedBuckets := 0

	ctxLoop, spanLoop := observability.ChildSpan(ctx, "cdc.recon.window_loop_b", attribute.Int("windows_count", len(bucketKeys)))
	defer spanLoop.End()

	// Smart Tracing: bypass window sạch
	ctxLoop = observability.ContextWithSkipTrace(ctxLoop)

	for k := range bucketKeys {
		sh, ms := shBuckets[k], msBuckets[k]
		totalShadow += sh.Count
		totalMaster += ms.Count
		if sh.Count == ms.Count && sh.Xor == ms.Xor {
			continue
		}
		driftedBuckets++
		bLo := time.UnixMilli(k).UTC()
		bHi := bLo.Add(time.Hour)

		ctxDrift, spanDrift := observability.ChildSpan(ctxLoop, "cdc.recon.drift_drill_down_b",
			attribute.String("bucket_time", bLo.Format(time.RFC3339)),
			attribute.Int64("shadow_count", sh.Count),
			attribute.Int64("master_count", ms.Count),
		)
		shIDTs, errS := rc.destAgent.ListIDTsInWindow(ctxDrift, shadowRel, segBPKColumn, tsCol, bLo, bHi)
		if errS != nil {
			observability.EndSpan(spanDrift, &errS)
			windowErrs++
			continue
		}
		msIDTs, errM := rc.masterAgent.ListIDTsInWindow(ctxDrift, masterRel, segBPKColumn, tsCol, bLo, bHi)
		if errM != nil {
			observability.EndSpan(spanDrift, &errM)
			windowErrs++
			continue
		}
		observability.EndSpan(spanDrift, nil)

		missB, orphB, staleB := diffIDTs(shIDTs, msIDTs)
		if len(missingFromMaster) < segBDiffIDCap {
			missingFromMaster = append(missingFromMaster, missB...)
		}
		if len(orphanInMaster) < segBDiffIDCap {
			orphanInMaster = append(orphanInMaster, orphB...)
		}
		if len(staleIDs) < segBDiffIDCap {
			staleIDs = append(staleIDs, staleB...)
		}
	}

	handle.windowsCount = len(bucketKeys)
	handle.mismatches = len(missingFromMaster) + len(orphanInMaster) + len(staleIDs)

	statusStr := "ok"
	if handle.mismatches > 0 {
		statusStr = "drift"
	}
	if windowErrs > 0 && handle.mismatches == 0 {
		statusStr = "error"
	}

	missJSON, _ := json.Marshal(missingFromMaster)
	staleJSON, _ := json.Marshal(map[string][]string{
		"missing_from_dest": missingFromMaster,
		"missing_from_src":  orphanInMaster,
		"mismatched":        staleIDs,
	})

	var totalShadowFull, totalMasterFull *int64
	if errSF == nil {
		totalShadowFull = &shadowFull
	}
	if errMF == nil {
		totalMasterFull = &masterFull
	}

	duration := int(time.Since(handle.started).Milliseconds())
	report := &recon.ReconciliationReport{
		TargetTable:      masterFQN,
		SourceDB:         "", // Để trống ở Segment B
		SourceCount:      &shadowActive,
		TotalSourceCount: totalShadowFull,
		TotalDestCount:   totalMasterFull,
		DestCount:        masterActive,
		Diff:             shadowActive - masterActive,
		MissingCount:     len(missingFromMaster),
		MissingIDs:       missJSON,
		StaleCount:       len(staleIDs) + len(orphanInMaster),
		StaleIDs:         staleJSON,
		OrphanCount:      len(orphanInMaster),
		CheckType:        "hash_window",
		Status:           statusStr,
		Segment:          segmentShadowMaster,
		DurationMs:       &duration,
		CheckedAt:        time.Now().UTC(),
		ReconStartTime:   &lower,
		ReconEndTime:     &upper,
	}
	rc.stampB(report, ref)

	rc.alertOnReport(ctx, segmentShadowMaster, ref.MasterTable, statusStr, len(missingFromMaster), report.Diff)
	metrics.ReconDrift.WithLabelValues(masterFQN, "4").Set(float64(handle.mismatches))

	errMsg := ""
	if windowErrs > 0 {
		finishStatus = "failed"
		errMsg = fmt.Sprintf("%d scan errors over %d buckets", windowErrs, len(bucketKeys))
	}
	rc.finishRun(ctx, handle, finishStatus, errMsg)

	observability.Ctx(ctx, rc.logger).Info("segment B shadow↔master (hash window)",
		zap.String("shadow", shadowRel), zap.String("master", masterRel),
		zap.Int("buckets", len(bucketKeys)), zap.Int("drifted_buckets", driftedBuckets),
		zap.Int("scan_errs", windowErrs),
		zap.Int64("shadow_rows", totalShadow), zap.Int64("master_rows", totalMaster),
		zap.Int("missing_from_master", len(missingFromMaster)),
		zap.Int("orphan_in_master", len(orphanInMaster)),
		zap.Int("stale_ids", len(staleIDs)),
	)

	return report
}

