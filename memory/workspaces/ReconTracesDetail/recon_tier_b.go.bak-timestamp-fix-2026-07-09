// diffIDTs — so 2 tập (id, ts): missing (shadow có master thiếu), orphan
// (master thừa), stale (id trùng nhưng ts lệch — master giữ bản khác).
func diffIDTs(shadow, master []IDTs) (missing, orphan, stale []string) {
	ms := make(map[string]int64, len(master))
	for _, it := range master {
		ms[it.ID] = it.Ts
	}
	sh := make(map[string]int64, len(shadow))
	for _, it := range shadow {
		sh[it.ID] = it.Ts
		if mts, ok := ms[it.ID]; !ok {
			missing = append(missing, it.ID)
		} else if (mts / 1000) != (it.Ts / 1000) {
			stale = append(stale, it.ID)
		}
	}
	for _, it := range master {
		if _, ok := sh[it.ID]; !ok {
			orphan = append(orphan, it.ID)
		}
	}
	return missing, orphan, stale
}

// SetPlaneDBs — raw handles cho L3-B row-diff (fetch _raw_data + master row).

func (rc *ReconCore) RunRowDiffB(ctx context.Context, ref MasterBindingRef, ids []string) []FieldDiff {
	if rc.shadowPlane == nil || rc.masterPlane == nil || len(ids) == 0 {
		return nil
	}
	if len(ids) > rowDiffMaxIDs {
		observability.Ctx(ctx, rc.logger).Warn("row-diff B: ids capped", zap.Int("total", len(ids)), zap.Int("cap", rowDiffMaxIDs))
		ids = ids[:rowDiffMaxIDs]
	}

	// Rules approved của binding — mirror query MasterDDLGenerator (077 self-contained).
	type ruleRow struct {
		SourceField  string  `gorm:"column:source_field"`
		SourcePath   *string `gorm:"column:source_path"`
		TargetColumn string  `gorm:"column:target_column"`
		TransformFn  *string `gorm:"column:transform_fn"`
	}
	var rules []ruleRow
	if err := rc.db.WithContext(ctx).Raw(`
		SELECT COALESCE(m.source_field, v2.source_field) AS source_field,
		       COALESCE(m.source_path, v2.source_path)   AS source_path,
		       m.target_column,
		       v2.transform_fn
		  FROM cdc_system.mapping_rule_master m
		  LEFT JOIN cdc_system.mapping_rule_v2 v2 ON v2.id = m.mapping_v2_id
		 WHERE m.master_binding_id = ? AND m.status = 'approved' AND m.is_active = true`,
		ref.ID).Scan(&rules).Error; err != nil || len(rules) == 0 {
		return nil
	}

	shadowRel := fmt.Sprintf("%q.%q", ref.ShadowSchema, ref.ShadowTable)
	masterRel := fmt.Sprintf("%q.%q", ref.MasterSchema, ref.MasterTable)

	// Fetch 2 phía theo _gpay_id (1 round-trip mỗi phía).
	type shadowRow struct {
		GpayID  string `gorm:"column:_gpay_id"`
		RawData []byte `gorm:"column:_raw_data"`
	}
	var shRows []shadowRow
	if err := rc.shadowPlane.WithContext(ctx).Raw(fmt.Sprintf(
		`SELECT _gpay_id::text AS _gpay_id, _raw_data FROM %s WHERE _gpay_id IN (?)`, shadowRel),
		ids).Scan(&shRows).Error; err != nil {
		observability.Ctx(ctx, rc.logger).Warn("row-diff B: shadow fetch failed", zap.Error(err))
		return nil
	}
	var msRows []map[string]any
	if err := rc.masterPlane.WithContext(ctx).Raw(fmt.Sprintf(
		`SELECT * FROM %s WHERE _gpay_id IN (?)`, masterRel), ids).Scan(&msRows).Error; err != nil {
		observability.Ctx(ctx, rc.logger).Warn("row-diff B: master fetch failed", zap.Error(err))
		return nil
	}
	masterByID := make(map[string]map[string]any, len(msRows))
	for _, r := range msRows {
		masterByID[fmt.Sprint(r["_gpay_id"])] = r
	}

	var diffs []FieldDiff
	for _, sr := range shRows {
		mrow, inMaster := masterByID[sr.GpayID]
		for _, rule := range rules {
			path := rule.SourceField
			if rule.SourcePath != nil && *rule.SourcePath != "" {
				path = *rule.SourcePath
			}
			val := gjson.GetBytes(sr.RawData, path)
			expected := any(nil)
			if val.Exists() {
				expected = val.Value()
			}
			if rule.TransformFn != nil && *rule.TransformFn != "" && master.IsTransformWhitelisted(*rule.TransformFn) {
				if tv, err := master.ApplyTransform(*rule.TransformFn, expected); err == nil {
					expected = tv
				}
			}
			expStr := normalizeDiffVal(expected)
			actStr := "<ROW MISSING>"
			if inMaster {
				actStr = normalizeDiffVal(mrow[rule.TargetColumn])
			}
			if expStr != actStr {
				diffs = append(diffs, FieldDiff{GpayID: sr.GpayID, Column: rule.TargetColumn, Expected: expStr, Actual: actStr})
				if len(diffs) >= rowDiffMaxEntries {
					observability.Ctx(ctx, rc.logger).Warn("row-diff B: entries capped", zap.Int("cap", rowDiffMaxEntries))
					return diffs
				}
			}
		}
	}
	return diffs
}

// normalizeDiffVal — chuỗi hoá loose để so 2 hệ kiểu (PG trả time.Time/decimal,
// gjson trả float64/string): trim + fmt.Sprint; nil/empty → "<NULL>".
func normalizeDiffVal(v any) string {
	if v == nil {
		return "<NULL>"
	}
	s := strings.TrimSpace(fmt.Sprint(v))
	if s == "" {
		return "<NULL>"
	}
	return s
}

// RunSegmentBFor — resolve master binding theo master_table rồi chạy Segment B.
// Trả nil khi không tìm thấy binding hợp lệ (caller log/respond error).
func (rc *ReconCore) RunSegmentBFor(ctx context.Context, masterTable string, deep bool) *recon.ReconciliationReport {
	for _, ref := range rc.ListActiveMasterBindings(ctx) {
		if ref.MasterTable == masterTable || ref.MasterRel() == masterTable {
			return rc.RunSegmentB(ctx, ref, deep)
		}
	}
	observability.Ctx(ctx, rc.logger).Warn("recon segment B: master binding not found/eligible",
		zap.String("master_table", masterTable))
	return nil
}

// CheckAllSegmentB — đối soát B cho mọi master binding active+approved.
// Leader-gated như CheckAll (A); per-binding advisory lock vẫn serialize.
func (rc *ReconCore) CheckAllSegmentB(ctx context.Context) []*recon.ReconciliationReport {
	isLeader, release := rc.AcquireLeader(ctx)
	defer release()
	if !isLeader {
		observability.Ctx(ctx, rc.logger).Info("recon CheckAllSegmentB — not leader, skipping")
		return nil
	}
	refs := rc.ListActiveMasterBindings(ctx)
	if len(refs) == 0 {
		observability.Ctx(ctx, rc.logger).Warn("recon CheckAllSegmentB: 0 active master bindings — nothing to reconcile",
			zap.String("fix_hint", "cần master_binding is_active=true + schema_status='approved'"))
		return nil
	}
	runID := uuid.NewString() // Migration 085: 1 phiên CheckAllSegmentB
	var reports []*recon.ReconciliationReport
	for _, ref := range refs {
		ref.RunID = runID
		if r := rc.RunSegmentB(ctx, ref, false); r != nil { // CheckAll: deep=false (row-diff theo yêu cầu per-table)
			reports = append(reports, r)
		}
	}
	if len(reports) == 0 {
		observability.Ctx(ctx, rc.logger).Warn("recon CheckAllSegmentB: 0 bindings checked — toàn bộ bị skip",
			zap.Int("bindings", len(refs)))
	}
	return reports
}

// TimeBoundedDiffMissingFromMaster performs comparison between shadow and master in a specific time range.
func (rc *ReconCore) TimeBoundedDiffMissingFromMaster(ctx context.Context, ref MasterBindingRef, startTime, endTime time.Time) ([]string, int, int, error) {
	if rc.shadowPlane == nil {
		return nil, 0, 0, fmt.Errorf("shadowPlane not wired")
	}
	if rc.masterPlane == nil {
		return nil, 0, 0, fmt.Errorf("masterPlane not wired")
	}

	ctx, span := observability.ChildSpan(ctx, "cdc.recon.time_bounded_diff_b", attribute.String("table", ref.runName()))
	var finalErr error
	defer func() { observability.EndSpan(span, &finalErr) }()

	startMs := startTime.UnixMilli()
	endMs := endTime.UnixMilli()

	// Resolve cột timestamp nghiệp vụ từ registry
	tsCol := "_source_ts"
	if entry, err := rc.registryRepo.GetByTargetTable(ctx, ref.MasterTable); err == nil && entry != nil {
		_, dstTS, errTS := rc.resolveSourceAndDestTSFields(ctx, *entry)
		if errTS == nil && dstTS != "" {
			tsCol = dstTS
		}
	}

	// Tải ID từ Postgres Shadow DB trong khoảng thời gian
	var shadowIDs []string
	shadowRel := ref.ShadowRel()
	var errS error
	if tsCol == "_source_ts" {
		shadowQuery := fmt.Sprintf(`SELECT %s::text FROM %s WHERE NOT "_deleted" AND "_source_ts" >= ? AND "_source_ts" < ?`,
			quoteIdent(segBPKColumn), quoteRelation(shadowRel))
		errS = rc.shadowPlane.WithContext(ctx).Raw(shadowQuery, startMs, endMs).Scan(&shadowIDs).Error
	} else {
		shadowQuery := fmt.Sprintf(`SELECT %s::text FROM %s WHERE NOT "_deleted" AND %s >= ? AND %s < ?`,
			quoteIdent(segBPKColumn), quoteRelation(shadowRel), quoteIdent(tsCol), quoteIdent(tsCol))
		errS = rc.shadowPlane.WithContext(ctx).Raw(shadowQuery, startTime, endTime).Scan(&shadowIDs).Error
	}
	if errS != nil {
		finalErr = errS
		return nil, 0, 0, fmt.Errorf("shadow query: %w", errS)
	}

	// Tải ID từ Postgres Master DB trong khoảng thời gian
	var masterIDs []string
	masterRel := ref.MasterRel()
	var errM error
	if tsCol == "_source_ts" {
		masterQuery := fmt.Sprintf(`SELECT %s::text FROM %s WHERE NOT "_deleted" AND "_source_ts" >= ? AND "_source_ts" < ?`,
			quoteIdent(segBPKColumn), quoteRelation(masterRel))
		errM = rc.masterPlane.WithContext(ctx).Raw(masterQuery, startMs, endMs).Scan(&masterIDs).Error
	} else {
		masterQuery := fmt.Sprintf(`SELECT %s::text FROM %s WHERE NOT "_deleted" AND %s >= ? AND %s < ?`,
			quoteIdent(segBPKColumn), quoteRelation(masterRel), quoteIdent(tsCol), quoteIdent(tsCol))
		errM = rc.masterPlane.WithContext(ctx).Raw(masterQuery, startTime, endTime).Scan(&masterIDs).Error
	}
	if errM != nil {
		finalErr = errM
		return nil, 0, 0, fmt.Errorf("master query: %w", errM)
	}

	masterSet := make(map[string]struct{}, len(masterIDs))
	for _, id := range masterIDs {
		masterSet[id] = struct{}{}
	}

	var missing []string
	for _, id := range shadowIDs {
		if _, exists := masterSet[id]; !exists {
			missing = append(missing, id)
		}
	}

	return missing, len(shadowIDs), len(masterIDs), nil
}

// ============================================================
// Heal — REMOVED in v3 root-cause fix (2026-04-17)
// ============================================================
//
// The legacy `ReconCore.Heal(ctx, entry, missingIDs)` walked `missingIDs`
// one row at a time, issued a Mongo FindOne + PG upsert per record AND
// wrote one `cdc_activity_log` row per record. On a corrupted Tier 2
// report that listed e.g. 1,713 rows the audit table exploded by 1,713
// rows per heal trigger, which made the CMS audit view unreadable.
//
// The v3 `ReconHealer.HealWindow` pathway supersedes it entirely:
//   - Audit batching (run_started + run_completed = 2 rows, regardless
//     of record count; plus at most a sample of per-record rows when
//     the `AuditSampleRate` is set).
//   - Batched `$in` Mongo reads instead of FindOne loops.
//   - OCC guard on `_source_ts` + per-table sensitive-field masking.
//   - Optional Debezium incremental snapshot signal (Phase A).
//
// Callsites audited on 2026-04-17: only `recon_handler.HandleReconHeal`
// referenced `rc.Heal`, and that fallback was deleted in the same
// commit. `rc.mongoClient` remains on the struct for future uses (e.g.
// source sampling) and to preserve the NewReconCore constructor
// signature.

