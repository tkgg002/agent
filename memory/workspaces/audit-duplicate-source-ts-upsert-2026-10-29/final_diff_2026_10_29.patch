+func qualifyShadowBindingTable(sb *shadow.ShadowBinding, fallbackTable string) string {
+	tbl := strings.TrimSpace(fallbackTable)
+	if sb != nil && strings.TrimSpace(sb.ShadowTable) != "" {
+		tbl = strings.TrimSpace(sb.ShadowTable)
+	}
+	if sb != nil && strings.TrimSpace(sb.ShadowSchema) != "" && tbl != "" && !strings.Contains(tbl, ".") {
+		return strings.TrimSpace(sb.ShadowSchema) + "." + tbl
+	}
+	return tbl
+}
+
+func (r *SnapshotRunner) flushSnapshotTables(
+	ctx context.Context,
+	targetTable string,
+	scopedBinding *shadow.ShadowBinding,
+	routes []*metadata.ResolvedSourceRoute,
+) (int, error) {
+	tableFlusher, hasTableFlush := r.eventHandler.(interface {
+		FlushTableBatchBuffer(ctx context.Context, targetTable string) (int, error)
+	})
+	if scopedBinding != nil {
+		targetTable = qualifyShadowBindingTable(scopedBinding, targetTable)
+	} else if len(routes) == 1 && routes[0] != nil {
+		if routes[0].TableConfig != nil && strings.TrimSpace(routes[0].TableConfig.TargetTable) != "" {
+			targetTable = strings.TrimSpace(routes[0].TableConfig.TargetTable)
+		}
+		targetTable = qualifyShadowBindingTable(routes[0].ShadowBinding, targetTable)
+	}
+	if !hasTableFlush || strings.TrimSpace(targetTable) == "" {
+		return r.eventHandler.FlushBatchBuffer(ctx)
+	}
+	if scopedBinding != nil || len(routes) <= 1 {
+		return tableFlusher.FlushTableBatchBuffer(ctx, targetTable)
+	}
+	totalFlushed := 0
+	seenTables := make(map[string]bool, len(routes))
+	for _, rt := range routes {
+		tName := targetTable
+		if rt != nil && rt.TableConfig != nil && rt.TableConfig.TargetTable != "" {
+			tName = rt.TableConfig.TargetTable
+		}
+		if rt != nil {
+			tName = qualifyShadowBindingTable(rt.ShadowBinding, tName)
+		}
+		if seenTables[tName] {
+			continue
+		}
+		seenTables[tName] = true
+		n, fErr := tableFlusher.FlushTableBatchBuffer(ctx, tName)
+		totalFlushed += n
+		if fErr != nil {
+			return totalFlushed, fErr
+		}
+	}
+	return totalFlushed, nil
+}
+
+func (r *SnapshotRunner) reloadRegistryBeforeSnapshot(ctx context.Context, sourceObjectID int64) {
+	reloader, ok := r.registrySvc.(interface {
+		ReloadAll(context.Context) error
+	})
+	if !ok {
+		return
+	}
+	if err := reloader.ReloadAll(ctx); err != nil {
+		observability.Ctx(ctx, r.logger).Warn("snapshot.v2 pre-flight registry reload failed (proceeding with stale cache)",
+			zap.Int64("source_object_id", sourceObjectID),
+			zap.Error(err))
+	}
+	if r.eventHandler != nil {
+		r.eventHandler.FlushCache()
+	}
+}
+
+func (r *SnapshotRunner) resetSnapshotTableErrors(
+	targetTable string,
+	scopedBinding *shadow.ShadowBinding,
+	routes []*metadata.ResolvedSourceRoute,
+) {
+	discarder, ok := r.eventHandler.(interface {
+		DiscardTableAsyncErrors(targetTable string)
+	})
+	if !ok {
+		return
+	}
+	if scopedBinding != nil {
+		discarder.DiscardTableAsyncErrors(qualifyShadowBindingTable(scopedBinding, targetTable))
+		return
+	}
+	if len(routes) <= 1 {
+		if len(routes) == 1 && routes[0] != nil {
+			if routes[0].TableConfig != nil && strings.TrimSpace(routes[0].TableConfig.TargetTable) != "" {
+				targetTable = strings.TrimSpace(routes[0].TableConfig.TargetTable)
+			}
+			targetTable = qualifyShadowBindingTable(routes[0].ShadowBinding, targetTable)
+		}
+		if strings.TrimSpace(targetTable) != "" {
+			discarder.DiscardTableAsyncErrors(targetTable)
+		}
+		return
+	}
+	for _, rt := range routes {
+		tName := targetTable
+		if rt != nil && rt.TableConfig != nil && rt.TableConfig.TargetTable != "" {
+			tName = rt.TableConfig.TargetTable
+		}
+		if rt != nil {
+			tName = qualifyShadowBindingTable(rt.ShadowBinding, tName)
+		}
+		if strings.TrimSpace(tName) != "" {
+			discarder.DiscardTableAsyncErrors(tName)
+		}
+	}
+}
+
