package reconmodel

import (
	"encoding/json"
	"time"
)

type ReconciliationReport struct {
	ID           uint64          `gorm:"primaryKey" json:"id"`
	TargetTable         string          `gorm:"column:target_table" json:"target_table"` // Keep for dynamic scan alias
	SourceDB            string          `gorm:"column:source_db" json:"source_db"`
	SourceType          string          `gorm:"column:source_type" json:"source_type,omitempty"`
	SourceHost          string          `gorm:"column:source_host" json:"source_host,omitempty"`
	SourceTable         string          `gorm:"column:source_table" json:"source_table,omitempty"`
	SourceCount         int64           `gorm:"column:source_count;default:0" json:"source_count"`
	DestCount           int64           `gorm:"column:dest_count;default:0" json:"dest_count"`
	Diff                int64           `gorm:"column:diff;default:0" json:"diff"`
	MissingCount        int             `gorm:"column:missing_count;default:0" json:"missing_count"`
	MissingIDs          json.RawMessage `gorm:"column:missing_ids;type:jsonb" json:"missing_ids"`
	StaleCount          int             `gorm:"column:stale_count;default:0" json:"stale_count"`
	StaleIDs            json.RawMessage `gorm:"column:stale_ids;type:jsonb" json:"stale_ids"`
	CheckType           string          `gorm:"column:check_type;not null" json:"check_type"`
	Status              string          `gorm:"column:status;not null" json:"status"`
	// Migration 081 (Recon V4) — 'source_shadow' (A) | 'shadow_master' (B).
	Segment string `gorm:"column:segment;default:source_shadow" json:"segment"`
	// Migration 085 — KHÓA PIPELINE ổn định (shadow_schema, shadow_table) có ở CẢ 2
	// segment → đọc per-pipeline gộp đủ A+B, hết collision target_table bare. run_id
	// gom row cùng 1 CheckAll = 1 "phiên".
	ShadowSchema string `gorm:"column:shadow_schema" json:"shadow_schema,omitempty"`
	ShadowTable  string `gorm:"column:shadow_table" json:"shadow_table,omitempty"`
	RunID        string `gorm:"column:run_id" json:"run_id,omitempty"`
	// Migration 083 (Recon V4 P4) — L3-B field-diff [{gpay_id, column, expected, actual}].
	FieldDiffs json.RawMessage `gorm:"column:field_diffs;type:jsonb" json:"field_diffs,omitempty"`
	// Migration 084 — TỔNG record thật 2 trạm tại thời điểm recon (≠ window counts).
	TotalSourceCount *int64     `gorm:"column:total_source_count" json:"total_source_count,omitempty"`
	TotalDestCount   *int64     `gorm:"column:total_dest_count" json:"total_dest_count,omitempty"`
	DurationMs       *int       `gorm:"column:duration_ms" json:"duration_ms"`
	ErrorMessage     *string    `gorm:"column:error_message" json:"error_message"`
	CheckedAt        time.Time  `gorm:"column:checked_at" json:"checked_at"`
	HealedAt         *time.Time `gorm:"column:healed_at" json:"healed_at"`
	HealedCount      int        `gorm:"column:healed_count;default:0" json:"healed_count"`
	OrphanCount      int        `gorm:"column:orphan_count;default:0" json:"orphan_count"`
	HealedDurationMs int        `gorm:"column:healed_duration_ms;default:0" json:"healed_duration_ms"`
	HealedMismatchedCount      int `gorm:"column:healed_mismatched_count;default:0" json:"healed_mismatched_count"`
	HealedMismatchedDurationMs int `gorm:"column:healed_mismatched_duration_ms;default:0" json:"healed_mismatched_duration_ms"`
	HealedMissingDestCount     int `gorm:"column:healed_missing_dest_count;default:0" json:"healed_missing_dest_count"`
	HealedMissingDestDurationMs int `gorm:"column:healed_missing_dest_duration_ms;default:0" json:"healed_missing_dest_duration_ms"`
	PrunedMissingSrcCount      int `gorm:"column:pruned_missing_src_count;default:0" json:"pruned_missing_src_count"`
	PrunedMissingSrcDurationMs int `gorm:"column:pruned_missing_src_duration_ms;default:0" json:"pruned_missing_src_duration_ms"`
	MasterSchema         string `gorm:"column:master_schema" json:"master_schema,omitempty"`
	MasterTable          string `gorm:"column:master_table" json:"master_table,omitempty"`
	ReconStartTime       *time.Time `gorm:"column:recon_start_time" json:"recon_start_time,omitempty"`
	ReconEndTime         *time.Time `gorm:"column:recon_end_time" json:"recon_end_time,omitempty"`
}

func (ReconciliationReport) TableName() string { return "cdc_reconciliation_report" }

