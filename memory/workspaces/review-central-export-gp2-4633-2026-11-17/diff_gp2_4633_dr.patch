+// data-transfers/params/trans-his/partner-user-reserve-export.params.ts
+import {
+    IsDateString,
+    IsNotEmpty,
+    IsOptional,
+    IsString,
+    Validate,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+    ValidationArguments
+} from "class-validator";
+import moment from "moment";
+import { MAX_DAYS_EXPORT } from "../../../utils/constants";
+
+@ValidatorConstraint({ name: "ExceedDateRangePartnerUserReserve", async: false })
+class ExceedDateRangeValidator implements ValidatorConstraintInterface {
+    public validate(value: any, args: ValidationArguments) {
+        const params = args.object as any;
+        if (!params.dateFr || !params.dateTo) {
+            return true;
+        }
+        const dateDiff = moment.duration(moment(new Date(params.dateTo)).diff(moment(new Date(params.dateFr)))).asDays();
+        return dateDiff <= MAX_DAYS_EXPORT;
+    }
+
+    public defaultMessage() {
+        return "EXCEED_DATE_RANGE_EXPORT";
+    }
+}
+
+/** Filters of UC04.R03 (Biến động khoản đảm bảo user), same names as GET /ops/collection-disbursement/reserve-movements */
+export class PartnerUserReserveExportParams {
+    @IsNotEmpty({ message: "ERR_DATE_FR_REQUIRED" })
+    @IsDateString({}, { message: "ERR_INVALID_DATE" })
+    public dateFr: string;
+
+    @IsNotEmpty({ message: "ERR_DATE_TO_REQUIRED" })
+    @IsDateString({}, { message: "ERR_INVALID_DATE" })
+    public dateTo: string;
+
+    /** Mã bản ghi: info.extData.reserveId */
+    @IsOptional() @IsString() public reserveId?: string;
+    /** Mã user liên kết: info.extData.partnerUserId */
+    @IsOptional() @IsString() public partnerUserId?: string;
+    /** Mã merchant: info.extData.merchantCode */
+    @IsOptional() @IsString() public merchantCode?: string;
+    /** Transaction status, e.g. "SUCCESS,FAILED" */
+    @IsOptional() @IsString() public status?: string;
+    /** Reserve profile status after the movement (PENDING, AUTHORIZED, TERMINATED), several values separated by commas: info.extData.statusAfter */
+    @IsOptional() @IsString() public statusAfter?: string;
+
+    @IsOptional() @IsString() public sortBy?: string;
+    @IsOptional() @IsString() public sortType?: string;
+
+    @IsOptional()
+    @Validate(ExceedDateRangeValidator)
+    public get dateRangeCheck(): boolean {
+        return true;
+    }
+}
