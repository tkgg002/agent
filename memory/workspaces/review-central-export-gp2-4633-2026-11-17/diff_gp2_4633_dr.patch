+++ b/logics/export/trans-his/partner-user-reserve-export.pure.ts
@@ -0,0 +1,150 @@
+// Pure functions of PartnerUserReserveExport (UC04 - Biến động khoản đảm bảo user)
+import moment from "moment";
+import * as _ from "lodash";
+import { ExportConfig } from "../../processors/BaseExportProcessor";
+import { GetAllPartnerUserReserveExportQuery } from "../../../domain/queries";
+import { PartnerUserReserveExportParams } from "../../../data-transfers/params";
+import { validateParams } from "../../../utils/validator";
+import { TRANSACTION_STATUS_LIST } from "../../../utils/constants";
+
+export const TRANS_TYPE_RESERVE = "PARTNER_RESERVE";
+export const TRANS_TYPE_RELEASE = "PARTNER_RESERVE_RELEASE";
+const STATUS_SUCCESS = "SUCCESS";
+
+/** Trạng thái sau biến động (UC04.R02) */
+export const RESERVE_STATUS_LABELS: Record<string, { vi: string; en: string }> = {
+    PENDING: { vi: "Chờ kích hoạt", en: "Pending" },
+    AUTHORIZED: { vi: "Đang hiệu lực", en: "Authorized" },
+    TERMINATED: { vi: "Đã chấm dứt", en: "Terminated" }
+};
+
+const isEmptyValue = (v: any): boolean => v === undefined || v === null || v === "";
+
+/** Conditions of the screen (same as the list API: the gateway adds trans_type IN (PARTNER_RESERVE, PARTNER_RESERVE_RELEASE)) */
+export const baseFilter = (): Record<string, any> => ({
+    transType: { $in: [TRANS_TYPE_RESERVE, TRANS_TYPE_RELEASE] }
+});
+
+/** UC04.R03 filters, mirroring buildFilter of GET /ops/collection-disbursement/reserve-movements (exact match, trimmed) */
+export const buildFilter = (params: any): Record<string, any> => {
+    const filter: Record<string, any> = baseFilter();
+    if (!isEmptyValue(params.reserveId)) { filter["info.extData.reserveId"] = String(params.reserveId).trim(); }
+    if (!isEmptyValue(params.merchantCode)) { filter["info.extData.merchantCode"] = String(params.merchantCode).trim(); }
+    if (!isEmptyValue(params.partnerUserId)) { filter["info.extData.partnerUserId"] = String(params.partnerUserId).trim(); }
+    let statuses: string[] | null = isEmptyValue(params.status) ? null : String(params.status).split(",");
+    if (!isEmptyValue(params.statusAfter)) {
+        filter["info.extData.statusAfter"] = { $in: String(params.statusAfter).split(",").map((s: string) => s.trim()) };
+        // statusAfter is only known for a successful transfer and is shown for those rows only, so the filter must not return the others
+        statuses = (statuses ?? [STATUS_SUCCESS]).filter((s) => s === STATUS_SUCCESS);
+    }
+    if (statuses) { filter.status = { $in: statuses }; }
+    if (params.dateFr || params.dateTo) {
+        filter.createdAt = {};
+        if (params.dateFr) { filter.createdAt.$gte = new Date(params.dateFr); }
+        if (params.dateTo) { filter.createdAt.$lte = new Date(params.dateTo); }
+    }
+    return filter;
+};
+
+const SORTABLE: Record<string, string> = { createdAt: "createdAt", value: "value", status: "status", transId: "transId" };
+
+export const buildSort = (params: any): object => {
+    const field = params?.sortBy ? SORTABLE[params.sortBy] : undefined;
+    if (field && !isEmptyValue(params?.sortType)) {
+        const asc = params.sortType === "asc" || params.sortType === "1" || params.sortType === 1;
+        return { [field]: asc ? 1 : -1 };
+    }
+    return { createdAt: -1 };
+};
+
+/** Neutralize a text cell that a spreadsheet would run as a formula (starts with = + - @, tab or CR) */
+export const safeText = (value: any): string => {
+    const text = value === undefined || value === null ? "" : String(value);
+    return /^[=+\-@\t\r]/.test(text) ? `'${text}` : text;
+};
+
+/** Balances come as numbers, numeric strings or Extended JSON wrappers such as {"$numberInt": "10"} */
+export const toNumber = (value: unknown): number | null => {
+    const raw = _.isPlainObject(value) ? Object.values(value as object)[0] : value;
+    if (raw === null || raw === undefined || raw === "") { return null; }
+    const parsed = Number(raw);
+    return Number.isFinite(parsed) ? parsed : null;
+};
+
+/**
+ * Reserve wallet balance before / after the transfer, as the list API computes it: info.senderBalance and info.receiverBalance are the
+ * balances of the two wallets before the transfer, so the reserve wallet balance before is the receiver balance for a reserve and the
+ * sender balance for a release. The balance after is only known for a successful transfer.
+ */
+export const reserveBalance = (item: any): { before: number | null; after: number | null } => {
+    const release = item.transType === TRANS_TYPE_RELEASE;
+    const before = toNumber(release ? item.info?.senderBalance : item.info?.receiverBalance);
+    const amount = toNumber(item.value);
+    if (before === null || amount === null || item.status !== STATUS_SUCCESS) {
+        return { before, after: null };
+    }
+    return { before, after: release ? before - amount : before + amount };
+};
+
+export const validate = (params: any, langCode: string = "vi"): PartnerUserReserveExportParams =>
+    validateParams<PartnerUserReserveExportParams>(PartnerUserReserveExportParams, params || {}, langCode);
+
+export const getConfig = (params: any, langCode: string = "vi"): ExportConfig => {
+    const validated = validate(params, langCode);
+    return {
+        query: new GetAllPartnerUserReserveExportQuery(buildFilter(validated), buildSort(validated)),
+        // Columns in the order of Template-bien-dong-khoan-dam-bao-user.xlsx
+        columns: [
+            { vi: "Ngày tạo", en: "Created At" },
+            { vi: "Mã người dùng GooPay", en: "GooPay User ID" },
+            { vi: "Mã user liên kết", en: "Linked User ID" },
+            { vi: "Số điện thoại", en: "Phone" },
+            { vi: "Tên người dùng", en: "User Name" },
+            { vi: "Mã merchant", en: "Merchant Code" },
+            { vi: "Tài khoản merchant", en: "Merchant Account" },
+            { vi: "Tên merchant", en: "Merchant Name" },
+            { vi: "Trạng thái sau biến động", en: "Status After Change" },
+            { vi: "Hạn mức khoản đảm bảo", en: "Reserve Limit" },
+            { vi: "Số dư trước biến động", en: "Balance Before" },
+            { vi: "Số dư sau biến động", en: "Balance After" },
+            { vi: "Trạng thái giao dịch", en: "Transaction Status" },
+            { vi: "Ghi chú", en: "Note" }
+        ],
+        fileName: {
+            // The file name is also the sheet name, and Excel allows at most 31 characters in a sheet name
+            vi: moment().format("DD-MM-YYYY") + "_Bien_dong_dam_bao",
+            en: moment().format("DD-MM-YYYY") + "_Reserve_movements"
+        },
+        maxRecords: 2_000_000
+    };
+};
+
+export const transformRow = (item: any, rowIndex: number, langCode: string = "vi"): any[] => {
+    const lang: "vi" | "en" = langCode === "en" ? "en" : "vi";
+    const extData = item.info?.extData ?? {};
+    const createdAt = item.createdAt ? moment(item.createdAt).utcOffset(7).format("DD/MM/YYYY HH:mm:ss") : "";
+    const { before, after } = reserveBalance(item);
+    // partner-service writes the profile outcome of a successful transfer into extData (GP2-4632); it holds only for a successful transfer
+    const succeeded = item.status === STATUS_SUCCESS;
+    const statusAfter = succeeded ? extData.statusAfter : undefined;
+    const reserveLimit = succeeded ? toNumber(extData.reserveLimit) : null;
+    const txStatus = TRANSACTION_STATUS_LIST.find((s: any) => s.value === item.status);
+
+    return [
+        createdAt,
+        safeText(item.sender?.customerId),
+        safeText(extData.partnerUserId),
+        safeText(item.sender?.phone),
+        safeText(item.sender?.fullName),
+        safeText(extData.merchantCode),
+        safeText(item.merchantEmail),
+        safeText(item.merchantName),
+        // Filled only when the record carries it (rows made before GP2-4632 do not)
+        safeText(RESERVE_STATUS_LABELS[statusAfter]?.[lang] || statusAfter),
+        reserveLimit ?? "",
+        before ?? "",
+        after ?? "",
+        safeText(txStatus?.label?.[lang] || item.status),
+        safeText(item.noted || extData.remark)
+    ];
+};
