diff --git a/domain/handlers/trans-his/GetAllPartnerUserReserveExportHandler.ts b/domain/handlers/trans-his/GetAllPartnerUserReserveExportHandler.ts
new file mode 100644
index 0000000..bf7d2e4
--- /dev/null
+++ b/domain/handlers/trans-his/GetAllPartnerUserReserveExportHandler.ts
@@ -0,0 +1,78 @@
+// Export of UC04 "Biến động khoản đảm bảo user": trans-his rows + email / name of the merchant
+import * as _ from "lodash";
+import { IQueryHandler } from "../../IQueryHandler";
+import { GetAllPartnerUserReserveExportQuery } from "../../queries";
+import MainProcess from "../../../data-transfers/main-process";
+
+const SELECT_FIELDS = {
+    transId: 1,
+    transType: 1,
+    status: 1,
+    value: 1,
+    noted: 1,
+    sender: 1,
+    info: 1,
+    createdAt: 1
+};
+
+export class GetAllPartnerUserReserveExportHandler implements IQueryHandler {
+    private mainProcess: MainProcess;
+
+    public constructor(mainProcess: MainProcess) {
+        this.mainProcess = mainProcess;
+    }
+
+    public async execute(query: GetAllPartnerUserReserveExportQuery, context: any, options: any): Promise<any> {
+        const { filter, sort } = query;
+        const { cursor, limit } = options?.params || {};
+        const TransHis = this.mainProcess.models.TransHisModel;
+        const Merchant = this.mainProcess.models.MerchantModel;
+
+        let findQuery = TransHis.find(filter).sort(sort).select(SELECT_FIELDS).limit(limit);
+        if (cursor && cursor > 0) {
+            findQuery = findQuery.skip(cursor);
+        }
+
+        const [rawData, total] = await Promise.all([
+            findQuery.lean().exec(),
+            cursor ? Promise.resolve(0) : TransHis.countDocuments(filter)
+        ]);
+
+        const merchantCodes = _.uniq(
+            (rawData || []).map((d: any) => d?.info?.extData?.merchantCode).filter((v: any) => !_.isEmpty(v))
+        );
+
+        const merchantMap = new Map<string, any>();
+        if (merchantCodes.length > 0) {
+            try {
+                const merchants = await Merchant.find({ merchantCode: { $in: merchantCodes } })
+                    .select({ merchantCode: 1, merchantEmail: 1, name: 1 })
+                    .lean()
+                    .exec();
+                for (const m of merchants || []) {
+                    merchantMap.set(String(m.merchantCode), m);
+                }
+            } catch (err) {
+                // A missing merchant must not break the export
+                this.mainProcess.logger?.warn(
+                    `[GetAllPartnerUserReserveExportHandler] merchant lookup failed: ${(err as Error)?.message}`
+                );
+            }
+        }
+
+        const data = (rawData || []).map((doc: any) => {
+            const merchant = merchantMap.get(String(doc?.info?.extData?.merchantCode));
+            return {
+                ...doc,
+                merchantEmail: merchant?.merchantEmail || doc?.info?.extData?.merchant?.email || "",
+                merchantName: merchant?.name || doc?.info?.extData?.merchant?.name || ""
+            };
+        });
+
+        return {
+            data,
+            nextCursor: Array.isArray(data) && data.length === limit ? (cursor || 0) + limit : null,
+            total
+        };
+    }
+}
diff --git a/logics/export/trans-his/partner-user-reserve-export.pure.ts b/logics/export/trans-his/partner-user-reserve-export.pure.ts
