              options={shadowRules.map(r => ({
                label: `${r.source_field} (${r.data_type}) [${r.status}]`,
                value: r.id
              }))}
            />
          </div>
          <Text type="secondary" style={{ display: 'block', textAlign: 'center' }}>— HOẶC bóc field con (nested) → cột dạng aa_bbb —</Text>
          <div>
            <span style={{ display: 'inline-block', width: 140, fontWeight: 'bold' }}>Nested path:</span>
            <Input
              style={{ width: 'calc(100% - 140px)' }}
              placeholder="vd: params.channelId (→ cột params_channelId)"
              value={nestedPath}
              onChange={(e) => {
                const v = e.target.value;
                setNestedPath(v);
                setTargetColumnName(v.trim() ? v.trim().replace(/\./g, '_') : '');
              }}
            />
          </div>
          <div>
            <span style={{ display: 'inline-block', width: 140, fontWeight: 'bold' }}>Data type (nested):</span>
            <Select
              style={{ width: 'calc(100% - 140px)' }}
              value={nestedDataType}
              onChange={setNestedDataType}
              options={['TEXT', 'VARCHAR(255)', 'INTEGER', 'BIGINT', 'NUMERIC', 'BOOLEAN', 'TIMESTAMP', 'JSONB'].map((t) => ({ label: t, value: t }))}
            />
          </div>
          <div>
            <span style={{ display: 'inline-block', width: 140, fontWeight: 'bold' }}>Target Column Name:</span>
            <Input
              style={{ width: 'calc(100% - 140px)' }}
              placeholder="vd: user_id (nested tự điền aa_bbb)"
              value={targetColumnName}
              onChange={e => setTargetColumnName(e.target.value)}
            />
          </div>
        </Space>
      </Modal>

      {/* Flatten discovery modal — Master CẦN flatten để normalize JSON arrays → cột riêng */}
      <Modal
        open={flattenOpen}
        title="Scan Array (Flatten) → Tạo rules PENDING để duyệt"
        okText="Scan"
        cancelText="Huỷ"
        confirmLoading={scanningArray}
        onOk={handleScanArray}
        onCancel={() => { setFlattenOpen(false); setExplodePath(''); }}
      >
        <Alert
          type="info"
          showIcon
          style={{ marginBottom: 12 }}
          message="Master cần Flatten để normalize JSON thành cột riêng biệt."
          description="Chọn 1 field JSON (chỉ field JSONB mới flatten được). Tool sẽ quét các field nested bên trong → tạo mapping rule PENDING để duyệt. Sau đó bạn có thể promote vào master mapping."
        />
        <Typography.Text strong style={{ display: 'block', marginBottom: 4 }}>Chọn nhanh field JSON</Typography.Text>
        <Select
          style={{ width: '100%' }}
          showSearch
          allowClear
          placeholder="Chọn field JSON để flatten"
          value={shadowRules.some((r) => `${r.source_field}[*]` === explodePath || (r.target_column && `${r.target_column}[*]` === explodePath)) ? explodePath : undefined}
          onChange={(val) => setExplodePath(val || '')}
          optionFilterProp="label"
          notFoundContent="Không có field JSON nào (chỉ field JSONB mới flatten được)"
          options={(() => {
            const seen = new Set<string>();
            return shadowRules
              // Chỉ field JSON ĐÃ APPROVED trên shadow (chưa approve thì chưa nên flatten sang master).
              .filter((r) => (r.data_type || '').toUpperCase().includes('JSON') && r.status === 'approved')
              .map((r) => {
                const hasRename = r.target_column && r.target_column !== r.source_field;
                const labelText = hasRename
                  ? `${r.target_column} (gốc: ${r.source_field}) (${r.data_type})`
                  : `${r.source_field} (${r.data_type})`;
                return {
                  label: labelText,
                  value: `${r.source_field}[*]`,
                };
              })
              .filter((opt) => {
                if (seen.has(opt.value)) {
                  return false;
                }
                seen.add(opt.value);
                return true;
              });
          })()}
        />
        <Typography.Text strong style={{ display: 'block', margin: '12px 0 4px' }}>Hoặc tự nhập explode_path (lồng sâu)</Typography.Text>
        <Input
          placeholder="vd: params.items[*]  hoặc  after.orders[*].lines[*]"
          value={explodePath}
          onChange={(e) => setExplodePath(e.target.value)}
        />
        <Typography.Text type="secondary" style={{ display: 'block', marginTop: 4, fontSize: 12 }}>
          Dùng <Typography.Text code>[*]</Typography.Text> để bung mảng. Có thể nối nhiều cấp để bóc array lồng nhau, vd <Typography.Text code>params.items[*].sub[*]</Typography.Text>.
        </Typography.Text>
      </Modal>

      {/* [DISABLED] Scan Review Modal — xảy ra FK violation vì mapping_v2_id sai.
          Backend đã tự tạo pending records trong scan-array API rồi.
          Flow mới: quét xong → success toast → user review trong bảng chính.
      <Modal
        open={scanReviewOpen}
        title="Scan Review — Chọn fields thêm vào Master Mapping"
        width={760}
        okText="Thêm vào Mapping (Pending)"
        cancelText="Huỷ"
        confirmLoading={promoting}
        onOk={handlePromoteScannedRules}
        onCancel={() => {
          setScanReviewOpen(false);
          setScannedRules([]);
        }}
      >
        <Alert
          type="info"
          showIcon
          style={{ marginBottom: 12 }}
          message="Chọn fields để thêm vào mapping"
          description={
            <span>
              Các field được chọn sẽ được thêm vào <strong>mapping_rule_master</strong> với trạng thái <strong>pending</strong>.
              Sau đó vào bảng chính để review, chỉnh sửa target column / data type, rồi mới click <strong>Approve DDL</strong> để áp dụng vào bảng master.
            </span>
          }
        />
        <Table
          dataSource={(() => {
            let vid = -9000;
            const groups = new Map();
            scannedRules.forEach(r => {
              if (!groups.has(r.sourceField)) groups.set(r.sourceField, []);
              groups.get(r.sourceField).push(r);
            });
            const roots = [];
            groups.forEach((gRules, sf) => {
              const hasNested = gRules.some(r => !!r.sourcePath);
              if (!hasNested) {
                gRules.forEach(r => roots.push({ ...r, children: undefined }));
                return;
              }
              const rootNode = { id: vid--, sourceField: sf, sourcePath: null, dataType: 'JSONB', selected: false, children: [] };
              const pathMap = new Map();
              pathMap.set('', rootNode);
              gRules
                .filter(r => !!r.sourcePath)
                .sort((a, b) => (a.sourcePath || '').localeCompare(b.sourcePath || ''))
                .forEach(rule => {
                  const parts = (rule.sourcePath || '').replace(/^\$\.?/, '').split('.').filter(Boolean);
                  for (let i = 0; i < parts.length - 1; i++) {
                    const iPath = parts.slice(0, i + 1).join('.');
                    if (!pathMap.has(iPath)) {
                      const par = pathMap.get(parts.slice(0, i).join('.')) || rootNode;
                      const vn = { id: vid--, sourceField: sf, sourcePath: iPath, dataType: 'JSONB', selected: false, children: [] };
                      if (!par.children) par.children = [];
                      par.children.push(vn);
                      pathMap.set(iPath, vn);
                    }
                  }
                  const leafPPath = parts.slice(0, -1).join('.');
                  const leafPar = pathMap.get(leafPPath) || rootNode;
                  const leaf = { ...rule, children: undefined };
                  if (!leafPar.children) leafPar.children = [];
                  leafPar.children.push(leaf);
                });
              roots.push(rootNode);
            });
            roots.sort((a, b) => a.sourceField.localeCompare(b.sourceField));
            return roots;
          })()}
          rowKey="id"
          size="small"
          pagination={false}
          expandable={{ defaultExpandAllRows: true }}
          columns={[
            {
              title: 'Field',
              dataIndex: 'sourceField',
              render: (_, r) => {
                if (r.sourcePath) {
                  const parts = r.sourcePath.replace(/^\$\.?/, '').split('.').filter(Boolean);
                  const leaf = parts[parts.length - 1] || r.sourceField;
                  return (<Tooltip title={`${r.sourceField} → ${r.sourcePath}`}><code>{leaf}</code></Tooltip>);
                }
                return <code>{r.sourceField}</code>;
              }
            },
            {
              title: 'Path',
              dataIndex: 'sourcePath',
              render: (t, r) => {
                if (r.id < -8999) return <Tag color="orange">OBJECT</Tag>;
                return t ? <Text type="secondary" style={{ fontSize: 12 }}>{t}</Text> : <Text type="secondary">—</Text>;
              }
            },
            {
              title: 'Data Type',
              dataIndex: 'dataType',
              render: (t, r) => {
                if (r.id < -8999) return null;
                return <Tag color="blue">{t}</Tag>;
              }
            }
          ]}
          rowSelection={{
            checkStrictly: true,
            selectedRowKeys: scannedRules.filter(r => r.selected).map(r => r.id),
            onChange: (keys) => {
              const keySet = new Set(keys);
              setScannedRules(prev => prev.map(r => ({ ...r, selected: keySet.has(r.id) })));
            },
            getCheckboxProps: (record) => {
              if (record.id < -8999) return { disabled: true, style: { display: 'none' } };
              return {};
            }
          }}
        />
      </Modal>
      */}

    </div>
  );
}
