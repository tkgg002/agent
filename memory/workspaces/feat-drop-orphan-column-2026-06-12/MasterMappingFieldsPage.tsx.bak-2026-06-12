          }
        }}
        locale={{ emptyText: 'Chưa có mapping rules cho master table này.' }}
      />

      {/* Manual Mapping Creation Modal */}
      <Modal
        open={createOpen}
        title="Tạo Master Mapping Rule thủ công"
        okText="Tạo"
        cancelText="Huỷ"
        confirmLoading={creatingRule}
        onOk={handleCreateMapping}
        onCancel={() => {
          setCreateOpen(false);
          setSelectedMappingV2ID(undefined);
          setTargetColumnName('');
          setNestedPath('');
          setNestedDataType('TEXT');
        }}
      >
        <Space direction="vertical" style={{ width: '100%' }} size="middle">
          <div>
            <span style={{ display: 'inline-block', width: 140, fontWeight: 'bold' }}>Shadow Rule (v2):</span>
            <Select
              style={{ width: 'calc(100% - 140px)' }}
