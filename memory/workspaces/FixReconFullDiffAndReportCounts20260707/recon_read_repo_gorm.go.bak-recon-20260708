	       r.error_message,
	       r.duration_ms,
	       r.checked_at,
	       -- Tương thích ngược với ReconciliationReport
	       CASE WHEN r.segment = 'shadow_master' THEN r.master_table ELSE r.shadow_table END AS target_table,
	       r.source_count,
	       r.dest_count,
	       r.source_count AS nullable_source_count,
	       NULL AS error_code,
