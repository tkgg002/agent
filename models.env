# AI Models Configuration for Antigravity Brain/Muscle System
# Last Updated: 2026-02-25

# --- BRAIN CONFIGURATION (Planning & Monitoring) ---
# Format: provider:model:key,provider2:model2:key2...
export BRAIN_POOL="antigravity:gemini-3-pro-high:default,openai:gpt-4o:sk-brain1,anthropic:claude-3-5-sonnet:sk-brain2"
export BRAIN_PROVIDER="antigravity"
export BRAIN_MODEL="gemini-3-pro-high"

# --- MUSCLE CONFIGURATION (Execution & CLI) ---
# Format: provider:model:key,...
export MUSCLE_POOL="antigravity:gemini-3-flash:default,grok:grok-2-rc:xai-muscle1,ollama:qwen35-muscle:local"
export MUSCLE_PROVIDER="antigravity"
export MUSCLE_MODEL="gemini-3-flash"

# --- LOCAL MUSCLE (Ollama, 0 API cost; Apple M4 16GB bench 2026-11-12: ~16 tok/s gen, ~22 tok/s tool-call) ---
# Build once: ollama create qwen35-muscle -f tooling/local_llm/Modelfile.qwen35-9b-muscle
# Smoke:      python3 tooling/local_llm/local_llm_smoke.py  (2026-11-12: PASS, chat 7s, tool-call 11s MATCH)
# NOTE: Qwen3.5 keeps <think> ON via OpenAI-compatible /v1 (content empty when max_tokens small).
#       Use native /api/chat with "think": false for Muscle tasks; /v1 only when thinking is wanted.
export LOCAL_MUSCLE_BASE_URL="http://127.0.0.1:11434"
export LOCAL_MUSCLE_MODEL="qwen35-muscle"
export OLLAMA_FLASH_ATTENTION="1"
export OLLAMA_KV_CACHE_TYPE="q8_0"

# --- SYSTEM SETTINGS ---
export TRACK_MODEL_USAGE=true
export ANTHROPIC_DEFAULT_HAIKU_MODEL="gemini-3-flash"
export ANTHROPIC_DEFAULT_SONNET_MODEL="gemini-3-pro-high"

# Tip: Run 'source agent/models.env' before starting a session
